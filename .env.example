# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # publishable / anon key — Google sign-in and realtime "changed" pings
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # server-only; all reads/writes go through this

# Parts: each person adds their own Onshape API keys on /tracker/designs, so
# their syncs bill to their own Onshape API allowance (migration 20261113170000).
# ONSHAPE_BASE_URL=https://cad.onshape.com   # only for an Onshape enterprise domain

# Work: project updates are also posted to this Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# Legacy shared upload-only token for Mayhem (at least 32 random characters).
# It cannot list or download team recordings; per-device tokens from Connect Mayhem can.
ROBOT_LOG_UPLOAD_TOKEN=

# File storage on Cloudflare R2 (docs/CLOUDFLARE_MIGRATION.md). When all four are
# set, files go to R2; until then they stay in Supabase Storage.
# R2 → Manage API tokens → Create token: "Object Read & Write", this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
